# IFK — reglas del servidor

DirectoryIndex index.php

# Todo lo que no sea un archivo de verdad entra por index.php, que decide
# si el visitante ve la fachada, el mantenimiento o el sitio completo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /correo lleva al webmail del hosting. Va antes que todo lo demás para que
  # mande aunque exista una carpeta "correo" en la raíz: si existiera, Apache
  # la serviría él y esta regla no alcanzaría a correr.
  RewriteRule ^correo/?$ /webmail [R=302,L]

  # Las carpetas internas no se sirven nunca
  RewriteRule ^(app|datos|vistas|contenido)/ - [F,L]

  # Sin barra al final (menos en la raíz): /contacto/ → /contacto
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Imágenes, CSS y demás archivos existentes salen directo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

# El archivo con el token no se sirve nunca por el navegador
<FilesMatch "^config(-ejemplo)?\.php$">
  Require all denied
</FilesMatch>

# Seguridad básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/json
</IfModule>

# Las imágenes y el CSS llevan ?v=fecha en la dirección, así que se pueden
# guardar mucho tiempo: al cambiarlas, cambia la dirección.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 6 months"
  ExpiresByType image/webp  "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/css    "access plus 6 months"
</IfModule>
